# ---- Auth (single-user shared secret) ----
APP_TOKEN=change-me-to-a-long-random-string

# ---- Database (Postgres + pgvector) ----
DATABASE_URL=postgresql://lookback:lookback@localhost:5432/lookback

# ---- Object storage ----
# STORAGE_DRIVER=disk uses a local persistent volume (fine for n=1).
# STORAGE_DRIVER=r2 uses Cloudflare R2 (S3-compatible).
STORAGE_DRIVER=disk
STORAGE_DISK_PATH=./.storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---- Models / integrations ----
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3-pro
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=1408
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
GOOGLE_PLACES_API_KEY=

# ---- Web push (VAPID) ----
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Server ----
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:5173
