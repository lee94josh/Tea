# ---- Auth (single-user shared secret) ----
APP_TOKEN=change-me-to-a-long-random-string

# ---- Database (Postgres; pgvector optional) ----
DATABASE_URL=postgresql://lookback:lookback@localhost:5432/lookback

# ---- Object storage ----
# STORAGE_DRIVER=disk uses a local persistent volume (fine for n=1).
#   On Railway: create a Volume mounted at /data and set STORAGE_DISK_PATH=/data
# STORAGE_DRIVER=r2 uses Cloudflare R2 (S3-compatible).
STORAGE_DRIVER=disk
STORAGE_DISK_PATH=./.storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---- Models / integrations ----
# ONE key runs everything: vision analysis, seed generation, and conversation
# all use Gemini when ANTHROPIC_API_KEY is unset. Venue lookup uses keyless
# OpenStreetMap (Nominatim) when GOOGLE_PLACES_API_KEY is unset.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-pro-latest
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=1408
# Optional upgrades (leave blank to run Gemini-only):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
GOOGLE_PLACES_API_KEY=

# ---- Web push (VAPID) ----
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Server ----
PORT=8080
# Leave empty in production (single-origin: server serves the PWA, URLs are
# relative). Set to http://localhost:8080 only for cross-origin local dev.
PUBLIC_BASE_URL=
WEB_ORIGIN=http://localhost:5173
