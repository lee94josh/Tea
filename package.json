{
  "name": "lookback",
  "version": "0.1.0",
  "private": true,
  "description": "Lookback — a photo-conversation PWA. Upload photos, get pre-generated, grounded conversation openers.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check-exif": "pnpm --filter @lookback/scripts check-exif",
    "dev:server": "pnpm --filter @lookback/server dev",
    "dev:web": "pnpm --filter @lookback/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "migrate": "pnpm --filter @lookback/server migrate"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "tsx": "^4.19.2"
  }
}
